+  int m_realtimeHevcExtradataPendingStreamId{-1};
+  int m_realtimeHevcExtradataPendingSource{STREAM_SOURCE_NONE};
+  AVCodecID m_realtimeHevcExtradataPendingCodec{AV_CODEC_ID_NONE};
+  int m_realtimeHevcExtradataPendingWidth{0};
+  int m_realtimeHevcExtradataPendingHeight{0};
   bool m_realtimeHevcPostResetGate{false};
   bool m_realtimeHevcPostResetVideoSeen{false};
   bool m_realtimeHevcPostResetAudioReady{false};
