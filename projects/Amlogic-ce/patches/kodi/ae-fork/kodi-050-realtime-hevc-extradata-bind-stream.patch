   m_realtimeHevcPostResetGate = false;
   m_realtimeHevcPostResetVideoSeen = false;
   m_realtimeHevcPostResetAudioReady = false;
@@ -5933,6 +5948,12 @@ bool CVideoPlayer::OpenStream(CCurrentSt
                 "VideoPlayer: realtime HEVC extradata recovery succeeded ({} bytes)",
                 hint.extradata.GetSize());
       m_realtimeHevcExtradataPending = false;
+      m_realtimeHevcExtradataPendingDemuxerId = -1;
+      m_realtimeHevcExtradataPendingStreamId = -1;
+      m_realtimeHevcExtradataPendingSource = STREAM_SOURCE_NONE;
+      m_realtimeHevcExtradataPendingCodec = AV_CODEC_ID_NONE;
+      m_realtimeHevcExtradataPendingWidth = 0;
+      m_realtimeHevcExtradataPendingHeight = 0;
     }
 
     if (current.type == StreamType::SUBTITLE)
@@ -5986,6 +6007,12 @@ bool CVideoPlayer::OpenStream(CCurrentSt
                   "VideoPlayer: realtime HEVC opening deferred; preserve client parser until raw extradata is extracted");
       }
       m_realtimeHevcExtradataPending = true;
+      m_realtimeHevcExtradataPendingDemuxerId = demuxerId;
+      m_realtimeHevcExtradataPendingStreamId = iStream;
+      m_realtimeHevcExtradataPendingSource = source;
+      m_realtimeHevcExtradataPendingCodec = hint.codec;
+      m_realtimeHevcExtradataPendingWidth = hint.width;
+      m_realtimeHevcExtradataPendingHeight = hint.height;
       CLog::Log(LOGWARNING,
                 "VideoPlayer: realtime HEVC stream has no extradata yet, keep stream enabled for retry");
     }
diff -Naurp orig/xbmc/cores/VideoPlayer/VideoPlayer.h new/xbmc/cores/VideoPlayer/VideoPlayer.h
