+      m_realtimeHevcExtradataPendingWidth == m_CurrentVideo.hint.width &&
+      m_realtimeHevcExtradataPendingHeight == m_CurrentVideo.hint.height;
+
+  if (resetDemuxer && realtime && pendingHevcStreamMatches)
   {
     CLog::Log(LOGWARNING,
